# Skopiuj do .env (plik poza gitem) i uzupełnij. Zmienne ustawione w terminalu mają pierwszeństwo.
# Tylko ścieżki i ustawienia; sekrety zostają w pliku klienta OAuth poza repozytorium.

# Plik JSON klienta OAuth Google (poza repozytorium). Ścieżkę wpisz bez cudzysłowu, w apostrofach albo z "/":
# w cudzysłowie podwójnym "\n" w ścieżce (np. C:\nowy) staje się znakiem nowej linii.
TRIVIMO_GOOGLE_CLIENT_FILE=

# Automatyczne odświeżanie co tyle minut (15–1440); puste = tylko ręcznie.
TRIVIMO_GOOGLE_SYNC_MINUTES=

# Opcjonalny katalog z takeout-raw.sqlite; puste = %LOCALAPPDATA%\Trivimo.
TRIVIMO_DATA_DIR=

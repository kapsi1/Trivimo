{
  "name": "trivimo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25 || >=26.13 <27"
  },
  "scripts": {
    "dev": "tsx watch apps/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "import:takeout": "tsx apps/server/import-takeout.ts",
    "preview:takeout": "tsx apps/server/preview-takeout.ts",
    "verify:takeout": "tsx apps/server/verify-takeout.ts",
    "backup:takeout": "tsx apps/server/backup-takeout.ts",
    "verify:restore": "tsx scripts/verify-restore.ts",
    "migrate:canonical": "tsx apps/server/migrate-canonical.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "csv-parse": "6.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.4"
  }
}
